# Production Gitignore - Keep only essential files

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Environment variables
.env
.env.local
.env.production

# Media files (upload to server separately)
media/certificates/*
media/uploads/*
!media/certificates/.gitkeep
!media/uploads/.gitkeep

# Static files (will be collected)
staticfiles/
static_root/

# Cache
.cache
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backup files
*.bak
*.backup

# Credentials
credentials.json
token.json
cred.py

# Temporary files
*.tmp
*.temp
