# ==============================================================================
# OFFER LETTER GENERATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate with your environment-specific settings.
# ==============================================================================

# Django Core Settings
# Generate a secret key in python using: from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())
SECRET_KEY=your-django-secret-key-replace-with-a-secure-random-string
DEBUG=True

# Allowed Hosts & Domains (comma-separated or configured in settings)
ALLOWED_HOSTS=offerletters.cscindia.org.in,www.offerletters.cscindia.org.in,127.0.0.1,localhost
SITE_DOMAIN=offerletters.cscindia.org.in
SITE_PROTOCOL=https
BASE_URL=https://offerletters.cscindia.org.in

# Database Configuration
# Default engine is SQLite (db.sqlite3). If configuring PostgreSQL for production:
DB_NAME=offerletter_db
DB_USER=offerletter_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Email / SMTP Configuration (ZeptoMail / Gmail / Custom SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email_user_or_api_key
EMAIL_HOST_PASSWORD=your_email_password_or_token
DEFAULT_FROM_EMAIL=learn@cscindia.org.in

# Google Drive Cloud Backup (Optional)
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Custom Asset Paths (Optional - defaults to media/ and static/)
CSC_LOGO_PATH=
CERTIFICATE_FONT_PATH=
